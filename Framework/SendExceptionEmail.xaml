  <Sequence DisplayName="Send Exception Email" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <If DisplayName="If - Exception email is not configured" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[in_Config Is Nothing OrElse Not in_Config.ContainsKey("ExceptionEmail_To") OrElse String.IsNullOrWhiteSpace(in_Config("ExceptionEmail_To").ToString) OrElse Not in_Config.ContainsKey("SMTP_Server") OrElse String.IsNullOrWhiteSpace(in_Config("SMTP_Server").ToString)]</InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:LogMessage DisplayName="Log Message - Email not configured" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Warn" Message="[&quot;Exception email not sent: ExceptionEmail_To or SMTP_Server is empty in Config. Subject: &quot; &amp; in_Subject &amp; &quot; | Body: &quot; &amp; in_Body &amp; &quot; | Attachment: &quot; &amp; in_AttachmentPath]" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <TryCatch DisplayName="Try Catch - Send email (a failure here must not hide the original exception)" sap2010:WorkflowViewState.IdRef="TryCatch_1">
            <TryCatch.Try>
              <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_4">
                <Sequence.Variables>
                  <Variable x:TypeArguments="x:String" Name="smtpUser" />
                  <Variable x:TypeArguments="ss:SecureString" Name="smtpPassword" />
                  <Variable x:TypeArguments="scg:List(x:String)" Name="attachments" />
                </Sequence.Variables>
                <ui:GetRobotCredential TimeoutMS="{x:Null}" AssetName="[in_Config(&quot;SMTP_CredentialAssetName&quot;).ToString]" CacheStrategy="None" DisplayName="Get Credential - SMTP account" sap2010:WorkflowViewState.IdRef="GetRobotCredential_1" Password="[smtpPassword]" Username="[smtpUser]" />
                <Assign DisplayName="Assign - Attachment list (empty when there is no screenshot file)" sap2010:WorkflowViewState.IdRef="Assign_1">
                  <Assign.To>
                    <OutArgument x:TypeArguments="scg:List(x:String)">[attachments]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="scg:List(x:String)">[If(String.IsNullOrWhiteSpace(in_AttachmentPath) OrElse Not File.Exists(in_AttachmentPath), New List(Of String), New List(Of String) From {in_AttachmentPath})]</InArgument>
                  </Assign.Value>
                </Assign>
                <ui:SendMail Bcc="{x:Null}" Cc="{x:Null}" ContinueOnError="{x:Null}" From="{x:Null}" MailMessage="{x:Null}" Name="{x:Null}" Password="{x:Null}" ReplyTo="{x:Null}" ResourceAttachmentList="{x:Null}" ResourceAttachments="{x:Null}" Result="{x:Null}" TimeoutMS="{x:Null}" UseOAuth="{x:Null}" UseRichTextEditor="{x:Null}" Action="Forward" AttachmentInputMode="None" AttachmentsCollection="[attachments]" Body="[in_Body]" ConnectionMode="Undefined" CreatedAfterSolutionSupport="True" DisplayName="Send SMTP Email - Exception notification" Email="[smtpUser]" EnableSSL="True" sap2010:WorkflowViewState.IdRef="SendMail_1" IgnoreCRL="False" IsBodyHtml="False" Port="[CInt(in_Config(&quot;SMTP_Port&quot;).ToString)]" SecureConnection="Auto" SecurePassword="[smtpPassword]" Server="[in_Config(&quot;SMTP_Server&quot;).ToString]" Subject="[in_Subject]" To="[in_Config(&quot;ExceptionEmail_To&quot;).ToString]" UseISConnection="False">
                  <ui:SendMail.AttachmentsBackup>
                    <usau:BackupSlot x:TypeArguments="umame:AttachmentInputMode" StoredValue="{x:Null}">
                      <usau:BackupSlot.BackupValues>
                        <scg:Dictionary x:TypeArguments="umame:AttachmentInputMode, scg:List(x:Object)" />
                      </usau:BackupSlot.BackupValues>
                    </usau:BackupSlot>
                  </ui:SendMail.AttachmentsBackup>
                  <ui:SendMail.ConnectionDetailsBackupSlot>
                    <usau:BackupSlot x:TypeArguments="umae:ConnectionDetails" StoredValue="{x:Null}">
                      <usau:BackupSlot.BackupValues>
                        <scg:Dictionary x:TypeArguments="umae:ConnectionDetails, scg:List(x:Object)" />
                      </usau:BackupSlot.BackupValues>
                    </usau:BackupSlot>
                  </ui:SendMail.ConnectionDetailsBackupSlot>
                  <ui:SendMail.Files>
                    <scg:List x:TypeArguments="InArgument(x:String)" Capacity="0" />
                  </ui:SendMail.Files>
                </ui:SendMail>
                <ui:LogMessage DisplayName="Log Message - Email sent" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;Exception email sent to &quot; &amp; in_Config(&quot;ExceptionEmail_To&quot;).ToString &amp; &quot;. Subject: &quot; &amp; in_Subject &amp; &quot; | Attachments: &quot; &amp; attachments.Count.ToString]" />
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Catch" sap2010:WorkflowViewState.IdRef="Sequence_5">
                    <ui:LogMessage DisplayName="Log Message - Email failed" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Error" Message="[&quot;Exception email could not be sent: &quot; &amp; exception.Message &amp; &quot; | Subject: &quot; &amp; in_Subject &amp; &quot; | Body: &quot; &amp; in_Body]" />
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
