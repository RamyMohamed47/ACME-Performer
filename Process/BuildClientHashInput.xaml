  <Sequence DisplayName="Build Client Hash Input" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <If DisplayName="If - A client field is empty" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[String.IsNullOrWhiteSpace(in_ClientId) OrElse String.IsNullOrWhiteSpace(in_ClientName) OrElse String.IsNullOrWhiteSpace(in_ClientCountry)]</InArgument>
