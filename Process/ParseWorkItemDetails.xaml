  <Sequence DisplayName="Parse Work Item Details" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Assign DisplayName="Assign - Client ID" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[out_ClientId]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Regex.Match(If(in_ClientInformationText, String.Empty), &quot;Client ID:(?: |\t)*(.*)&quot;).Groups(1).Value.Trim()]</InArgument>
